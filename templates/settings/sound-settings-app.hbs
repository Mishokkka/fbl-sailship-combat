<div class="ssc-sound-settings">
  <header>
    <div>
      <h2>Звуки боя</h2>
      <p>Настройки сохраняются отдельно для каждого клиента. Пустой путь использует встроенный процедурный эффект.</p>
    </div>
    <label class="ssc-sound-enabled">
      <input type="checkbox" data-sound-field="enabled" {{#if profile.enabled}}checked{{/if}}>
      <span>Включить звуки</span>
    </label>
  </header>

  <label class="ssc-sound-master">
    <span>Общая громкость <b>{{volumePercent}}%</b></span>
    <input type="range" min="0" max="1" step="0.05" value="{{profile.volume}}" data-sound-field="volume">
  </label>

  <div class="ssc-sound-event-list">
    {{#each events as |sound|}}
      <section class="ssc-sound-event-card">
        <h3><i class="{{sound.icon}}"></i> {{sound.label}}</h3>
        <div class="ssc-sound-path-row">
          <input type="text" value="{{sound.path}}" data-sound-path="{{sound.type}}" placeholder="Встроенный процедурный звук">
          <button type="button" data-action="browseSound" data-sound-type="{{sound.type}}" title="Выбрать аудиофайл"><i class="fa-solid fa-folder-open"></i></button>
          <button type="button" data-action="previewSound" data-sound-type="{{sound.type}}" title="Прослушать"><i class="fa-solid fa-play"></i></button>
        </div>
        <label>
          <span>Громкость события: {{sound.volumePercent}}%</span>
          <input type="range" min="0" max="1" step="0.05" value="{{sound.volume}}" data-sound-volume="{{sound.type}}">
        </label>
      </section>
    {{/each}}
  </div>

  <footer>
    <button type="button" data-action="resetSoundSettings"><i class="fa-solid fa-arrow-rotate-left"></i> Сбросить</button>
    <button type="button" class="primary" data-action="saveSoundSettings"><i class="fa-solid fa-floppy-disk"></i> Сохранить</button>
  </footer>
</div>
