        {{#if phaseFlags.showTurnBox}}
          <section class="ssc-turn-box">
            <div class="ssc-turn-heading">
            {{#if activeShip}}
              <div class="ssc-active-ship">Ход: <strong>{{activeShip.name}}</strong></div>
            {{else}}
              <div class="ssc-active-ship muted">{{localize "SAILSHIPS.AllShipsDone"}}</div>
            {{/if}}
            {{#if actionState.phaseBudget}}
              <span class="ssc-turn-ap" title="Очки действий: осталось / всего. Потрачено: {{actionState.spentAP}}">ОД <strong>{{actionState.remainingAP}}/{{actionState.phaseBudget}}</strong></span>
            {{/if}}
            </div>
            {{#if isGM}}<button type="button" class="ssc-narrow-pass" data-action="passTurn" title="{{passTurnTitle}}" {{#unless canPassTurn}}disabled{{/unless}}>Завершить действие</button>{{/if}}
            {{#if pacing.available}}
            <div class="ssc-pacing-control">
              <button type="button" class="ssc-advance-action primary" data-action="advanceToDecision"
              data-battle-id="{{battle.id}}" data-revision="{{battle.revision}}" data-round="{{battle.round}}" data-phase="{{battle.phase}}" data-active-id="{{battle.turn.activeShipId}}"
              title="Пропустить только ожидание. Остановиться перед доступным действием или после расчёта одного раунда." {{#if pacing.disabled}}disabled{{/if}}>
              <i class="fa-solid fa-forward" aria-hidden="true"></i> К следующему решению
            </button>
              <p>Пропускает ожидание до ближайшего действия. Приказы, манёвры и эвакуация — вручную.</p>
            </div>
            {{/if}}
            {{#if pacing.notice}}<p class="ssc-pacing-notice" role="status">{{pacing.notice}}</p>{{/if}}
            <details class="ssc-disclosure" data-ui-section="turn-order" open><summary>Очередь · {{turnOrder.length}}</summary><div class="ssc-turn-list ssc-turn-queue">
              {{#each turnOrder as |turnShip|}}
                <button type="button" class="ssc-turn-pill ssc-turn-row side-{{turnShip.side}} readiness-{{turnShip.readiness.kind}} {{#if turnShip.active}}active{{/if}} {{#if turnShip.done}}done{{/if}}"
                  data-action="selectTurnUnit" data-ship-id="{{turnShip.id}}" title="{{turnShip.readiness.reason}}" style="--ssc-side-color: {{turnShip.sideColor}};" {{#if turnShip.active}}aria-current="true"{{/if}}>
                  <span class="ssc-turn-unit">{{#if turnShip.active}}<i class="fa-solid fa-caret-right" aria-hidden="true"></i>{{/if}}<strong>{{turnShip.name}}</strong>{{#if turnShip.initiative}}<em title="Инициатива">{{turnShip.initiative}}</em>{{/if}}</span>
                  <span class="ssc-turn-readiness">{{turnShip.readiness.label}}</span>
                </button>
              {{/each}}
            </div>
            </details>
            {{#unless actionState.isActive}}
              <p class="ssc-hint">{{localize "SAILSHIPS.NotActiveShipHint"}}</p>
            {{/unless}}
          </section>
        {{/if}}
