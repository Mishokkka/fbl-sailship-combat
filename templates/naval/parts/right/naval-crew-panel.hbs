{{#if phaseFlags.crew}}
<section class="ssc-crew-workbench" aria-label="Работа экипажа">
  <header class="ssc-crew-heading">
    <div><span class="ssc-eyebrow">Борьба за живучесть</span><h3>Куда направить команду?</h3></div>
    <span class="ssc-crew-ap">{{crewControl.remainingAP}} ОД</span>
  </header>
  <p class="ssc-hint">{{#if crewControl.boosted}}Аварийные партии: усиленный ремонт и два ОД.{{else}}Каждая работа стоит 1 ОД.{{/if}} Один вид работ доступен один раз за фазу; помпы и пробоины делят одну команду, расчистка и ремонт системы — другую.</p>
  {{#if crewControl.noProblems}}<p class="ssc-crew-empty">Пожаров, течей и повреждённых систем нет. Ядро и мораль в порядке.</p>{{/if}}
  <div class="ssc-crew-tasks">
    {{#each crewControl.tasks as |task|}}
    <article class="ssc-crew-task {{#if task.urgent}}is-urgent{{/if}}" data-task-id="{{task.id}}">
      <header><span class="ssc-eyebrow">{{task.location}}</span><span class="ssc-crew-priority">{{#if task.suggested}}Первый приоритет{{else}}{{task.priorityLabel}}{{/if}}</span></header>
      <h4>{{task.title}}</h4>
      <p class="ssc-crew-consequence">{{task.consequence}}</p>
      <div class="ssc-crew-forecast"><span>{{task.metric}}</span><strong>{{task.before}} → {{task.after}}{{#if task.max}} <small>/ {{task.max}}</small>{{/if}}</strong></div>
      {{#if task.secondary}}<p class="ssc-hint">{{task.secondary}}</p>{{/if}}
      <p class="ssc-crew-effect">{{task.effect}}</p>
      {{#if task.risk}}<p class="ssc-crew-risk">{{task.risk}}</p>{{/if}}
      {{#if task.blockedReason}}<p class="ssc-crew-blocked">{{task.blockedReason}}</p>{{/if}}
      <button type="button" class="{{#if task.suggested}}primary{{/if}}" data-action="crewTask" data-task-id="{{task.id}}" data-ship-id="{{../selectedShip.id}}" data-revision="{{../battle.revision}}" {{#unless task.canUse}}disabled{{/unless}}>{{task.button}} <span>· {{task.cost}} ОД</span></button>
    </article>
    {{/each}}
  </div>
  {{#if crewControl.unavailable.length}}
  <details class="ssc-disclosure" data-ui-section="crew-unrepairable">
    <summary>Не восстановить в бою · {{crewControl.unavailable.length}}</summary>
    {{#each crewControl.unavailable}}<p class="ssc-hint"><strong>{{location}} · {{title}}</strong><br>{{blockedReason}}</p>{{/each}}
  </details>
  {{/if}}
</section>

<details class="ssc-action-box ssc-disclosure ssc-crew-boarding" data-ui-section="crew-boarding" {{#if crewControl.boardingRelevant}}open{{/if}}>
  <summary>Абордаж и защита палубы</summary>
  {{#if crewControl.boardingRelevant}}
    {{#if crewControl.boardingTargets.length}}
    <p class="ssc-hint">Выберите соседний корабль для сцепки:</p>
    <div class="ssc-target-picker">{{#each crewControl.boardingTargets}}<button type="button" class="ssc-target-row {{#if selected}}active{{/if}}" data-target-id="{{id}}" aria-pressed="{{selected}}">{{name}}</button>{{/each}}</div>
    {{/if}}
    {{#each crewControl.boarding}}
    <div class="ssc-crew-boarding-action">
      <p>{{text}}</p>
      {{#if blockedReason}}<p class="ssc-hint">{{blockedReason}}</p>{{/if}}
      <button type="button" data-action="{{action}}" {{#unless canUse}}disabled{{/unless}}>{{label}} · 1 ОД</button>
    </div>
    {{/each}}
  {{else}}<p class="ssc-hint">Рядом нет цели для сцепки. Абордаж доступен после сцепки с противником на той же высоте.</p>{{/if}}
</details>

<details class="ssc-action-box ssc-disclosure" data-ui-section="crew-abandon">
  <summary>Оставить корабль</summary>
  <p class="ssc-hint">{{crewControl.abandonText}}</p>
  <button type="button" class="danger" data-action="abandonShip" {{#unless crewControl.canAbandon}}disabled{{/unless}}>Оставить корабль · 1 ОД</button>
</details>
{{/if}}
