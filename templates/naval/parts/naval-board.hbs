      <section class="ssc-board-panel {{#if terrainMode}}terrain-mode{{/if}}">
        <svg tabindex="0" aria-label="Тактическое поле. Выберите подсвеченную клетку для предпросмотра маршрута." class="ssc-board-svg" viewBox="{{board.viewBox}}" preserveAspectRatio="xMidYMid meet" role="img" data-pixel-width="{{board.pixelWidth}}" data-pixel-height="{{board.pixelHeight}}" data-lod="{{board.lod}}">
          <defs>
            {{> "modules/sailships-combat/templates/naval/parts/naval-unit-art.hbs"}}
            <marker id="ssc-arrow" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto" markerUnits="strokeWidth">
              <path d="M0,0 L0,6 L6,3 z"></path>
            </marker>
            <pattern id="{{board.background.pattern.id}}" patternUnits="userSpaceOnUse" width="{{board.background.pattern.width}}" height="{{board.background.pattern.height}}">
              <path class="ssc-infinite-grid-pattern-line" d="{{board.background.pattern.path}}"></path>
            </pattern>
            {{#if board.background.image.enabled}}
            <pattern id="{{board.background.image.id}}" patternUnits="userSpaceOnUse" width="{{board.background.image.tileSize}}" height="{{board.background.image.tileSize}}">
              <image class="ssc-board-image-pattern" href="{{board.background.image.href}}" x="0" y="0" width="{{board.background.image.tileSize}}" height="{{board.background.image.tileSize}}" preserveAspectRatio="xMidYMid slice"></image>
            </pattern>
            {{/if}}
          </defs>

          <rect class="ssc-board-bg {{#if board.terrainPaintable}}terrain-paintable{{/if}}" x="{{board.background.backdrop.x}}" y="{{board.background.backdrop.y}}" width="{{board.background.backdrop.width}}" height="{{board.background.backdrop.height}}"></rect>
          {{#if board.background.image.enabled}}
          <rect class="ssc-board-image-fill" x="{{board.background.backdrop.x}}" y="{{board.background.backdrop.y}}" width="{{board.background.backdrop.width}}" height="{{board.background.backdrop.height}}" fill="url(#{{board.background.image.id}})" opacity="{{board.background.image.opacity}}"></rect>
          {{/if}}
          <rect class="ssc-infinite-grid-lines" x="{{board.background.backdrop.x}}" y="{{board.background.backdrop.y}}" width="{{board.background.backdrop.width}}" height="{{board.background.backdrop.height}}" fill="url(#{{board.background.pattern.id}})"></rect>
          <path class="ssc-grid-lines" d="{{board.gridPath}}"></path>
          <rect class="ssc-board-bounds" x="{{board.background.bounds.x}}" y="{{board.background.bounds.y}}" width="{{board.background.bounds.width}}" height="{{board.background.bounds.height}}"></rect>

          <g class="ssc-terrain-layer">
            {{#each board.terrainClusters as |cluster|}}
              <g class="ssc-terrain-stack {{cluster.terrainClass}} {{#if cluster.blockedByTerrain}}blocked-terrain{{/if}}" data-terrain-cluster="{{cluster.id}}" data-terrain-cells="{{cluster.cellCount}}">
                <path class="ssc-terrain-cell {{cluster.terrainClass}}" d="{{cluster.path}}"></path>
                <path class="ssc-terrain-boundary-shadow" d="{{cluster.boundaryPath}}"></path>
                <path class="ssc-terrain-boundary {{cluster.terrainClass}}" d="{{cluster.boundaryPath}}"></path>
                <text class="ssc-terrain-icon {{cluster.terrainClass}}" x="{{cluster.cx}}" y="{{cluster.cy}}" text-anchor="middle" dominant-baseline="middle">{{cluster.terrainIcon}}</text>
              </g>
            {{/each}}
          </g>

          <g class="ssc-setup-zone-layer">
            {{#each board.setupZones as |zone|}}
              <g class="ssc-setup-zone side-{{zone.id}}" style="--ssc-side-color: {{zone.color}};">
                {{#each zone.cells as |cell|}}
                  <path d="{{cell.path}}"></path>
                {{/each}}
                <text x="{{zone.labelX}}" y="{{zone.labelY}}">{{zone.name}}</text>
              </g>
            {{/each}}
          </g>

          <g class="ssc-deploy-layer">
            {{#each board.deployable as |cell|}}
              <path class="ssc-cell deployable" d="{{cell.path}}"></path>
            {{/each}}
          </g>

          <g class="ssc-reachable-layer">
            {{#each board.reachable as |cell|}}
              <path class="ssc-cell reachable{{#if cell.collision}} collision-risk{{/if}}" d="{{cell.path}}"{{#if cell.collision}} aria-label="{{cell.collision.title}}"{{/if}}></path>
              <text class="ssc-reachable-step{{#if cell.collision}} collision-risk{{/if}}" x="{{cell.cx}}" y="{{cell.cy}}" text-anchor="middle" dominant-baseline="middle">{{#if cell.collision}}⚠{{else}}{{cell.steps}}{{/if}}</text>
            {{/each}}
          </g>

          <path class="ssc-hover-cell hidden" d=""></path>

          <g class="ssc-arc-overlays">
            {{#each board.arcs as |arc|}}
              <g class="ssc-fire-arc arc-{{arc.arc}} {{#if arc.focused}}is-focused{{/if}} {{#if arc.muted}}is-muted{{/if}}">
                <path class="ssc-fire-arc-sector" d="{{arc.path}}"></path>
              </g>
            {{/each}}
          </g>

          {{#if board.targetLine}}
            <line class="ssc-target-line" x1="{{board.targetLine.x1}}" y1="{{board.targetLine.y1}}" x2="{{board.targetLine.x2}}" y2="{{board.targetLine.y2}}"></line>
          {{/if}}

          <g class="ssc-wind-camera" transform="{{board.windCameraTransform}}" aria-hidden="true">
            <g class="ssc-wind-particles" opacity="{{board.windParticleOpacity}}" transform="rotate({{board.windParticleAngle}})">
              {{#each board.windParticles as |p|}}
                <line x1="{{p.x1}}" y1="{{p.y}}" x2="{{p.x2}}" y2="{{p.y}}" stroke-width="{{p.width}}" vector-effect="non-scaling-stroke">
                  <animateTransform attributeName="transform" type="translate" from="0 0" to="{{../board.windParticleTravel}} 0" dur="{{p.duration}}s" begin="{{p.delay}}s" repeatCount="indefinite"></animateTransform>
                </line>
              {{/each}}
            </g>
          </g>

          {{#each board.ships as |ship|}}
            <g class="ssc-ship-token {{#if ship.isCreature}}ssc-creature-token{{/if}} {{#if ship.attached}}attached{{/if}} {{#if ship.camouflaged}}camouflaged{{/if}} side-{{ship.side}} {{#if ship.contactState}}contact contact-{{ship.contactState}}{{/if}} {{#if ship.selected}}selected{{/if}} {{#if ship.active}}active-turn{{/if}} {{#if ship.phaseDone}}phase-done{{/if}} {{#if ship.targetable}}targetable{{/if}} {{#if ship.isTarget}}target-selected{{/if}}" style="--ssc-side-color: {{ship.sideColor}}; --ssc-creature-tint: {{ship.tokenTint}};" data-ship-id="{{ship.id}}" data-unit-type="{{ship.unitType}}" transform="translate({{ship.cx}} {{ship.cy}}) rotate({{ship.renderHeading}})">
              <ellipse class="ssc-ship-halo" cx="0" cy="0" rx="26" ry="23" transform="scale({{ship.visual.cellScale}})"></ellipse>
              <g class="ssc-unit-art {{#if ship.struck}}ssc-unit-disabled{{/if}} {{#if ship.isCreature}}ssc-unit-creature{{else}}ssc-unit-ship{{/if}}" data-family="{{ship.visual.family}}" transform="scale({{ship.visual.scale}})">
                {{#if ship.hasTokenImage}}
                  {{#unless ship.contactState}}<image class="ssc-creature-token-image" href="{{ship.tokenImage}}" x="-27" y="-27" width="54" height="54" preserveAspectRatio="xMidYMid meet" transform="rotate({{ship.visual.imageRotation}})"></image>{{/unless}}
                {{else}}
                  <use href="{{ship.visual.href}}"></use>
                {{/if}}
                {{#if ship.visualDamaged}}<path class="ssc-unit-damage" d="M-13 -5 L-5 2 L-10 6 M2 -4 L8 3 L4 6"></path>{{/if}}
                {{#if ship.visualBurning}}<path class="ssc-unit-fire" d="M-8 4 Q-16 -1 -11 -9 L-8 -4 L-5 -12 Q4 -1 -8 4Z"></path>{{/if}}
                {{#if ship.showAltitudeCore}}<path class="ssc-unit-core {{#if ship.visualCoreHot}}is-hot{{/if}}" d="M-18 -3 L-14 0 L-18 3 L-22 0Z"></path>{{/if}}
                <path class="ssc-unit-heading" d="M30 -3 L35 0 L30 3" fill="none"></path>
              </g>
              {{#if ship.attached}}<circle class="ssc-creature-attached-mark" cx="-22" cy="-22" r="5"></circle>{{/if}}
              <g class="ssc-token-ui" transform="rotate({{ship.counterHeading}})">
                {{#if ship.isCreature}}
                  {{#if ship.tokenShowName}}<text class="ssc-ship-label" x="0" y="{{ship.visual.labelY}}" text-anchor="middle">{{ship.name}}</text>{{/if}}
                {{else}}
                  <text class="ssc-ship-label" x="0" y="{{ship.visual.labelY}}" text-anchor="middle">{{ship.name}}</text>
                {{/if}}
                {{#if ship.canViewDetails}}
                <rect class="ssc-token-hp-bg" x="-26" y="{{ship.visual.hpY}}" width="52" height="4" rx="2"></rect>
                <rect class="ssc-token-hp-fill" x="-26" y="{{ship.visual.hpY}}" width="{{ship.hpWidth}}" height="4" rx="2"></rect>
                {{/if}}
                {{#if ship.isCreature}}
                  <text class="ssc-token-badge crystal" x="-6" y="{{ship.visual.badgeY}}">H{{ship.status.altitude}}</text>
                  {{#if ship.status.bleeding}}<text class="ssc-token-badge breach" x="-24" y="{{ship.visual.statusY}}">К{{ship.status.bleeding}}</text>{{/if}}
                  {{#if ship.status.stunned}}<text class="ssc-token-badge grapple" x="8" y="{{ship.visual.statusY}}">О{{ship.status.stunned}}</text>{{/if}}
                  {{#if ship.status.burning}}<text class="ssc-token-badge fire" x="-6" y="{{ship.visual.status2Y}}">F</text>{{/if}}
                  {{#if ship.status.camouflaged}}<text class="ssc-token-badge camouflage" x="10" y="{{ship.visual.status2Y}}">М{{ship.status.camouflaged}}</text>{{/if}}
                  {{#if ship.attached}}<text class="ssc-token-badge grapple" x="-24" y="{{ship.visual.badgeY}}">⚓</text>{{/if}}
                  {{#if ship.rulesPending}}<text class="ssc-token-badge pending-rules" x="10" y="{{ship.visual.badgeY}}">◇</text>{{/if}}
                {{else}}
                  {{#if ship.status.fire}}<text class="ssc-token-badge fire" x="-24" y="{{ship.visual.statusY}}">F{{ship.status.fire}}</text>{{/if}}
                  {{#if ship.status.flooding}}<text class="ssc-token-badge water" x="8" y="{{ship.visual.statusY}}">W{{ship.status.flooding}}</text>{{/if}}
                  {{#if ship.status.breaches}}<text class="ssc-token-badge breach" x="-6" y="{{ship.visual.status2Y}}">B{{ship.status.breaches}}</text>{{/if}}
                  {{#if ship.showAltitudeCore}}<text class="ssc-token-badge crystal" x="-6" y="{{ship.visual.badgeY}}">H{{ship.status.altitude}} Я{{ship.status.coreHeat}}</text>{{/if}}
                  {{#if ship.showAltitudeCore}}{{#if ship.status.falling}}<text class="ssc-token-badge falling" x="-24" y="{{ship.visual.badgeY}}">↓</text>{{/if}}{{/if}}
                  {{#if ship.grappled}}<text class="ssc-token-badge grapple" x="-24" y="{{ship.visual.badgeY}}">⚓</text>{{/if}}
                {{/if}}
                {{#if ship.withdrawn}}<text class="ssc-token-badge withdrawn" x="8" y="{{ship.visual.badgeY}}">↗</text>{{else}}{{#if ship.struck}}<text class="ssc-token-badge struck" x="8" y="{{ship.visual.badgeY}}">⚑</text>{{/if}}{{/if}}
              </g>
            </g>
          {{/each}}
        {{#unless board.movementPlan.preview}}{{#with board.turnCue}}
        <g class="ssc-turn-cue" aria-hidden="true"><polyline points="{{points}}"></polyline><circle cx="{{cx}}" cy="{{cy}}" r="7"></circle><text x="{{cx}}" y="{{cy}}" dy="-16" text-anchor="middle">Поворот после {{delay}} гекс.</text></g>
        {{/with}}{{/unless}}
        {{#with board.movementPlan.preview}}
        <g class="ssc-movement-route {{#if collision}}has-collision{{/if}}" aria-hidden="true">
          <polyline class="ssc-route-line" points="{{routePoints}}"></polyline>
          {{#each steps}}
          <circle class="ssc-route-step" cx="{{cx}}" cy="{{cy}}" r="5"></circle>
          {{/each}}
          {{#if contact}}
          <line class="ssc-route-contact" x1="{{cx}}" y1="{{cy}}" x2="{{contact.cx}}" y2="{{contact.cy}}"></line>
          <circle class="ssc-route-contact" cx="{{contact.cx}}" cy="{{contact.cy}}" r="20"></circle>
          {{/if}}
          <g class="ssc-route-ghost" transform="translate({{cx}} {{cy}})">
            <circle r="25"></circle>
            <path d="M 23 0 L -13 -12 L -7 0 L -13 12 Z" transform="rotate({{renderHeading}})"></path>
            <text y="41" text-anchor="middle">Остановка · {{destination}}</text>
          </g>
        </g>
        {{#with endOfRound}}{{#if hasPath}}
        <g class="ssc-drift-cue" aria-hidden="true">
          <polyline points="{{points}}"></polyline>
          <g transform="translate({{cx}} {{cy}})"><circle r="19"></circle><path d="M 12 0 L -7 -6 L -3 0 L -7 6 Z" transform="rotate({{renderHeading}})"></path></g>
        </g>
        {{/if}}{{/with}}
        {{/with}}
        </svg>

        <div class="ssc-terrain-tooltip hidden" role="tooltip" aria-live="polite"></div>

        <div class="ssc-board-phase-strip" aria-label="Этапы раунда">
          <strong class="ssc-round-label">Раунд {{battle.round}}</strong>
          {{#each phases as |phase|}}
            <span class="ssc-phase-pill {{#if phase.active}}active{{/if}} {{#if phase.done}}done{{/if}}" {{#if phase.active}}aria-current="step"{{/if}}><b>{{phase.number}}</b> {{sscPhase phase.id}}</span>
          {{/each}}
        </div>

        {{#if battleOutcome}}
        <section class="ssc-battle-outcome" role="status" aria-live="polite">
          <span>Бой завершён · раунд {{battleOutcome.round}}</span>
          <h3>{{battleOutcome.title}}</h3>
          <p>{{battleOutcome.summary}}</p>
          {{#if battleOutcome.scoreRows}}<div class="ssc-outcome-scores">
            {{#each battleOutcome.scoreRows as |side|}}<span class="{{#if side.winner}}winner{{/if}}">{{side.name}}: {{side.score}}%</span>{{/each}}
          </div>{{/if}}
          {{#if battleOutcome.canContinue}}<button type="button" data-action="continueBattle"><i class="fa-solid fa-forward"></i> Продолжить на 5 раундов</button>{{/if}}
        </section>
        {{/if}}

        {{#unless board.movementPlan.preview}}
        <div class="ssc-board-status-stack">
          {{#if battleMode.usesWater}}
          <div class="ssc-board-status-card" title="Состояние моря. Бурное море и шторм ухудшают стрельбу и устойчивость.">
            <span>Море</span>
            <strong>{{sscSeaState battle.sea.state}}</strong>
          </div>
          {{/if}}
          <div class="ssc-board-status-card" title="Видимость. Дымка, туман и ночь дают штрафы к попаданию и целеуказанию.">
            <span>Видимость</span>
            <strong>{{sscVisibility battle.sea.visibility}}</strong>
          </div>
          <div class="ssc-wind-widget {{#if board.windInfo.calm}}is-calm{{/if}}" style="--ssc-wind-angle: {{battle.wind.direction}}deg" title="{{board.windInfo.title}}" aria-label="{{board.windInfo.title}}">
            <span class="ssc-wind-widget-label">Ветер</span>
            <span class="ssc-wind-widget-compass">
              <span class="ssc-wind-widget-arrow"></span>
            </span>
            <span class="ssc-wind-widget-heading">{{board.windInfo.flow}}</span><span class="ssc-wind-strength">{{board.windInfo.strength}}</span>
          </div>
        </div>

        {{/unless}}
        {{#with board.movementPlan.preview}}
        <section class="ssc-movement-plan {{#if hasWarnings}}has-warnings{{/if}}" aria-label="План манёвра">
          <div class="ssc-plan-body">
            {{#if @root.board.movementPlan.notice}}<p class="ssc-plan-danger" role="status">{{@root.board.movementPlan.notice}}</p>{{/if}}
            <div class="ssc-plan-heading"><span>План манёвра</span><strong>{{shipName}}</strong></div>
            <p class="ssc-plan-destination">Остановка {{destination}} <span>· курс {{heading}}° · путь {{distance}} гекс.</span></p>
            <div class="ssc-plan-stats">
              <span>Ход после манёвра* <strong>{{speedBefore}} → {{speedAfter}}</strong></span>
              <span>Стоимость <strong>{{apCost}} ОД</strong></span>
              {{#if showAltitude}}<span>Высота сейчас <strong>H{{altitudeNow}}</strong></span>
              <span>К концу раунда* <strong>H{{altitudeEnd}}</strong></span>{{/if}}
            </div>
            <p class="ssc-plan-drift"><span class="ssc-drift-key" aria-hidden="true"></span><b>Конец раунда*</b> · {{endOfRound.driftText}}{{#if endOfRound.hasPath}} · клетка {{endOfRound.destination}}{{/if}}</p>
            {{#if collision}}<p class="ssc-plan-danger">Столкновение: корабль остановится перед клеткой контакта.</p>{{/if}}
            {{#if hasWarnings}}
            <details class="ssc-plan-risks" {{#if collision}}open{{/if}}>
              <summary>Последствия и риски · {{warnings.length}}</summary>
              <ul>{{#each warnings}}<li>{{this}}</li>{{/each}}</ul>
            </details>
            {{/if}}
            <p class="ssc-plan-note">* При сохранении условий, без последствий новых повреждений. Движение завершит активацию. До подтверждения маршрут можно заменить другой клеткой.</p>
          </div>
          <div class="ssc-plan-actions">
            <button type="button" data-action="cancelMovementPlan" {{#if @root.board.movementPlan.busy}}disabled{{/if}}>Отмена <kbd>Esc</kbd></button>
            <button type="button" class="{{#if collision}}danger{{else}}primary{{/if}}" data-action="confirmMovementPlan" {{#if @root.board.movementPlan.busy}}disabled{{/if}}>
              {{#if @root.board.movementPlan.busy}}Выполняется…{{else}}{{#if collision}}Подтвердить столкновение{{else}}Выполнить манёвр{{/if}}{{/if}}
            </button>
          </div>
        </section>
        {{else}}
        <div class="ssc-board-control-dock">
          {{#if pacing.available}}<button type="button" class="ssc-advance-action primary" data-action="advanceToDecision"
              data-battle-id="{{battle.id}}" data-revision="{{battle.revision}}" data-round="{{battle.round}}" data-phase="{{battle.phase}}" data-active-id="{{battle.turn.activeShipId}}"
              title="Пропустить только ожидание. Остановиться перед доступным действием или после расчёта одного раунда." {{#if pacing.disabled}}disabled{{/if}}>
              <i class="fa-solid fa-forward" aria-hidden="true"></i> К следующему решению
            </button>{{/if}}
          {{#if @root.reportOnBoard}}
          {{#with @root.battleReport}}
          <section class="ssc-report-toast" role="status" aria-live="polite">
            <div><span>{{label}}</span><strong>{{title}}</strong><p>{{outcomeLabel}}</p>{{#with leadChange}}<p class="ssc-toast-change">{{label}}: {{before}} → {{after}}</p>{{/with}}</div>
            <button type="button" data-action="showBattleReport">Последствия</button>
            <button type="button" class="ssc-report-dismiss" data-action="dismissBattleReport" aria-label="Скрыть результат на поле">×</button>
          </section>
          {{/with}}
          {{/if}}
          {{#if board.movementPlan.notice}}<p class="ssc-movement-notice" role="status">{{board.movementPlan.notice}}</p>{{/if}}
          <button type="button" class="ssc-overlay-action" data-action="passTurn" title="{{passTurnTitle}}" {{#unless canPassTurn}}disabled{{/unless}}>
            <i class="fa-solid fa-check" aria-hidden="true"></i><span>Завершить действие</span>
          </button>
          <button type="button" class="ssc-overlay-action primary" data-action="nextPhase" title="{{nextPhaseTitle}}" {{#unless canNextPhase}}disabled{{/unless}}>
            <i class="fa-solid fa-forward-step" aria-hidden="true"></i><span>{{nextPhaseLabel}}</span>
          </button>
        </div>
        {{/with}}
      </section>
      <div class="ssc-board-hint"><span>Колесико — масштаб · СКМ — камера · Alt — сведения о террейне</span><span class="ssc-board-cursor">—</span></div>
